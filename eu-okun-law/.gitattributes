# Frozen Eurostat snapshots must stay byte-identical to the SHA-256 hashes recorded in
# their manifests and READMEs: no Git LFS (overrides the repository-wide *.csv rule)
# and no line-ending conversion.
snapshots/** !filter !diff !merge -text

# Generated report outputs (classical review, Bayesian report): plain Git, not LFS,
# LF line endings exactly as written.
docs/**/*.csv !filter !diff !merge text eol=lf
docs/**/*.json text eol=lf
docs/*.md text eol=lf

# Publication sources and generated files: LF exactly as written, so the manifests and
# the --check comparison are identical on every platform.
publication/**/*.tex text eol=lf
publication/**/*.bib text eol=lf
publication/**/*.json text eol=lf
publication/**/*.md text eol=lf
