300,"261":350,"262":380,"263":320,"265":170,"266":240,"267":510,"268":280,"269":270},"id":["freq","statinfo","sex","age","so_eur","uaarea","unit","geo","time"],"size":[1,1,1,10,1,1,1,28,5],"dimension":{"freq":{"label":"Time frequency","category":{"index":{"A":0},"label":{"A":"Annual"}}},"statinfo":{"label":"Statistical information","category":{"index":{"TOTAL":0},"label":{"TOTAL":"Total"}}},"sex":{"label":"Sex","category":{"index":{"T":0},"label":{"T":"Total"}}},"age":{"label":"Age class","category":{"index":{"TOTAL":0,"Y_LT25":1,"Y25-34":2,"Y35-39":3,"Y35-44":4,"Y40-44":5,"Y45-54":6,"Y55-64":7,"Y_GE65":8,"NAP":9},"label":{"TOTAL":"Total","Y_LT25":"Less than 25 years","Y25-34":"From 25 to 34 years","Y35-39":"From 35 to 39 years","Y35-44":"From 35 to 44 years","Y40-44":"From 40 to 44 years","Y45-54":"From 45 to 54 years","Y55-64":"From 55 to 64 years","Y_GE65":"65 years or over","NAP":"Not applicable"}}},"so_eur":{"label":"Standard output in Euros","category":{"index":{"TOTAL":0},"label":{"TOTAL":"Total"}}},"uaarea":{"label":"Utilised agricultural area","category":{"index":{"TOTAL":0},"label":{"TOTAL":"Total"}}},"unit":{"label":"Unit of measure","category":{"index":{"HLD":0},"label":{"HLD":"Holding"}}},"geo":{"label":"Geopolitical entity (reporting)","category":{"index":{"EU27_2020":0,"BE":1,"BG":2,"CZ":3,"DK":4,"DE":5,"EE":6,"IE":7,"EL":8,"ES":9,"FR":10,"HR":11,"IT":12,"CY":13,"LV":14,"LT":15,"LU":16,"HU":17,"MT":18,"NL":19,"AT":20,"PL":21,"PT":22,"RO":23,"SI":24,"SK":25,"FI":26,"SE":27},"label":{"EU27_2020":"European Union - 27 countries (from 2020)","BE":"Belgium","BG":"Bulgaria","CZ":"Czechia","DK":"Denmark","DE":"Germany","EE":"Estonia","IE":"Ireland","EL":"Greece","ES":"Spain","FR":"France","HR":"Croatia","IT":"Italy","CY":"Cyprus","LV":"Latvia","LT":"Lithuania","LU":"Luxembourg","HU":"Hungary","MT":"Malta","NL":"Netherlands","AT":"Austria","PL":"Poland","PT":"Portugal","RO":"Romania","SI":"Slovenia","SK":"Slovakia","FI":"Finland","SE":"Sweden"}}},"time":{"label":"Time","category":{"index":{"2010":0,"2013":1,"2016":2,"2020":3,"2023":4},"label":{"2010":"2010","2013":"2013","2016":"2016","2020":"2020","2023":"2023"}}}},"extension":{"lang":"EN","description":"<p>The manager of the agricultural holding is the person responsible for the normal daily financial and production routines of the holding. Statistics on the manager’s age and sex help analyse the demographic structure of farm management, including generational renewal and gender balance in agriculture. Farm indicators measure key characteristics of agricultural holdings, such as farm size and type of farming. This table includes information on the number of agricultural holdings, hectares of utilised agricultural area (UAA), annual working units (AWU), livestock units (LSU) and economic output (standard output - SO), by managers’ age class and sex, class of economic output (standard output - SO) of the farm and class of utilised agricultural area (UAA), at regional (NUTS 2) level. Annual work unit (AWU) is the full-time equivalent employment, i.e. the total hours worked divided by the average annual hours worked in full-time jobs in the country. One annual work unit corresponds to the work performed by one person who is occupied on an agricultural holding on a full-time basis. The standard output is the average monetary value of the agricultural output at farm-gate price, in euro per hectare or per head of livestock. Information is based on censuses and sample surveys.</p>","id":"EF_M_FARMANG","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"EF_M_FARMANG","agencyId":"ESTAT","version":"33.0"},"annotation":[{"type":"CREATED","date":"2025-10-31T03:19:10+0100"},{"type":"DISSEMINATION_DOI_XML","title":"<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/E